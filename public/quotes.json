[
  {
    "text": "十年一觉扬州梦，赢得青楼薄幸名。",
    "from": "遣怀",
    "who": "杜牧"
  },
  {
    "text": "执子之手，与子偕老。",
    "from": "击鼓",
    "who": "佚名"
  },
  {
    "text": "春水碧于天，画船听雨眠。",
    "from": "菩萨蛮·人人尽说江南好",
    "who": "韦庄"
  },
  {
    "text": "黄河远上白云间，一片孤城万仞山。",
    "from": "凉州词二首·其一",
    "who": "王之涣"
  },
  {
    "text": "咬定青山不放松，立根原在破岩中。",
    "from": "竹石",
    "who": "郑燮"
  },
  {
    "text": "高山仰止，景行行止。",
    "from": "诗经",
    "who": ""
  },
  {
    "text": "旧时王谢堂前燕，飞入寻常百姓家。",
    "from": "乌衣巷",
    "who": "刘禹锡"
  },
  {
    "text": "花褪残红青杏小。燕子飞时，绿水人家绕。",
    "from": "蝶恋花·春景",
    "who": "苏轼"
  },
  {
    "text": "梅花雪，梨花月，总相思。",
    "from": "相见欢·年年负却花期",
    "who": "张惠言"
  },
  {
    "text": "远上寒山石径斜，白云深处有人家。",
    "from": "山行",
    "who": "杜牧"
  },
  {
    "text": "人生天地之间，若白驹之过隙，忽然而已。",
    "from": "庄子·外篇·知北游",
    "who": "庄子休"
  },
  {
    "text": "不敢言提笔出砚，倚马千言。亦必愿衣袂胜仙，惊才绝艳。",
    "from": "转竹林深处残碑小筑",
    "who": ""
  },
  {
    "text": "曾记否，到中流击水，浪遏飞舟？",
    "from": "沁园春·长沙",
    "who": "毛泽东"
  },
  {
    "text": "千古是非输蝶梦，一轮风雨属渔舟。",
    "from": "金陵晚眺（又作怀古）",
    "who": "崔涂"
  },
  {
    "text": "如何肯到清秋日，已带斜阳又带蝉。",
    "from": "柳",
    "who": ""
  },
  {
    "text": "青青园中葵，朝露待日晞。",
    "from": "长歌行",
    "who": "佚名"
  },
  {
    "text": "造物无言却有情，每于寒尽觉春生。",
    "from": "新雷",
    "who": "张维屏"
  },
  {
    "text": "生年不满百，常怀千岁忧。昼短苦夜长，何不秉烛游。",
    "from": "古诗十九首",
    "who": "不详"
  },
  {
    "text": "以色事他人，能得几时好。",
    "from": "妾薄命",
    "who": "李白"
  },
  {
    "text": "万事到头都是梦，休休。明日黄花蝶也愁。",
    "from": "南乡子·重九涵辉楼呈徐君猷",
    "who": "苏轼"
  },
  {
    "text": "抛得开手里玩具，先懂得好好进睡。",
    "from": "给自己的情书",
    "who": ""
  },
  {
    "text": "试问卷帘人，却道海棠依旧。",
    "from": "如梦令",
    "who": "李清照"
  },
  {
    "text": "欲买桂花同载酒，终不似、少年游。",
    "from": "唐多令·芦叶满汀洲",
    "who": "刘过"
  },
  {
    "text": "桃李春风一杯酒，江湖夜雨十年灯。",
    "from": "寄黄几复",
    "who": "黄庭坚"
  },
  {
    "text": "接天莲叶无穷碧，映日荷花别样红。",
    "from": "晓出净慈寺送林子方",
    "who": "杨万里"
  },
  {
    "text": "浮生只合尊前老。雪满长安道。",
    "from": "虞美人·寄公度",
    "who": "舒亶"
  },
  {
    "text": "若教眼底无离恨，不信人间有白头。",
    "from": "鹧鸪天·晚日寒鸦一片愁",
    "who": "辛弃疾"
  },
  {
    "text": "思悠悠，恨悠悠，恨到归时方始休。",
    "from": "长相思·汴水流",
    "who": "白居易"
  },
  {
    "text": "莫等闲，白了少年头，空悲切。",
    "from": "满江红",
    "who": "岳飞"
  },
  {
    "text": "银烛秋光冷画屏，轻罗小扇扑流萤。",
    "from": "秋夕",
    "who": "杜牧"
  },
  {
    "text": "不知几人真得鹿，毕竟终日梦为鱼。",
    "from": "杂诗七首其一",
    "who": "黄庭坚"
  },
  {
    "text": "青鸟不传云外信，丁香空结雨中愁。",
    "from": "摊破浣溪沙·手卷真珠上玉钩",
    "who": "李璟"
  },
  {
    "text": "子期竟早亡，牙琴从此绝。",
    "from": "五古·挽易昌陶",
    "who": "毛泽东"
  },
  {
    "text": "为有牺牲多壮志，敢教日月换新天。",
    "from": "七律·到韶山",
    "who": "毛泽东"
  },
  {
    "text": "绿蚁新醅酒，红泥小火炉。",
    "from": "问刘十九",
    "who": "白居易"
  },
  {
    "text": "春未绿，鬓先丝。人间别久不成悲。",
    "from": "鹧鸪天·元夕有所梦",
    "who": "姜夔"
  },
  {
    "text": "落霞与孤鹜齐飞，秋水共长天一色。",
    "from": "滕王阁序",
    "who": "王勃"
  },
  {
    "text": "乐夫天命复奚疑！",
    "from": "归去来兮辞",
    "who": "陶渊明"
  },
  {
    "text": "不识庐山真面目，只缘身在此山中。",
    "from": "题西林壁",
    "who": "苏轼"
  },
  {
    "text": "呜呼！楚虽三户能亡秦，岂有堂堂中国空无人！",
    "from": "金错刀行",
    "who": "陆游"
  },
  {
    "text": "红颜未老恩先断，斜倚薰笼坐到明。",
    "from": "后宫词",
    "who": "白居易"
  },
  {
    "text": "当年不肯嫁春风，无端却被秋风误。",
    "from": "芳心苦·杨柳回塘",
    "who": "贺铸"
  },
  {
    "text": "云无心以出岫，鸟倦飞而知还。",
    "from": "归去来兮辞",
    "who": "陶渊明"
  },
  {
    "text": "回首向来萧瑟处，归去， 也无风雨也无晴。",
    "from": "定风波",
    "who": "苏轼"
  },
  {
    "text": "树欲静而风不止，子欲养而亲不待。",
    "from": "增广贤文",
    "who": "佚名"
  },
  {
    "text": "等闲变却故人心，却道故人心易变。",
    "from": "木兰花·拟古决绝词柬友",
    "who": "纳兰性德"
  },
  {
    "text": "心似双丝网，中有千千结。",
    "from": "千秋岁·数声鶗鴂",
    "who": "张先"
  },
  {
    "text": "昨夜星辰昨夜风，画楼西畔桂堂东。",
    "from": "无题·昨夜星辰昨夜风",
    "who": "李商隐"
  },
  {
    "text": "水光潋滟晴方好，山色空蒙雨亦奇。",
    "from": "饮湖上初晴后雨二首·其二",
    "who": "苏轼"
  },
  {
    "text": "昨夜西风凋碧树，独上高楼，望尽天涯路。",
    "from": "蝶恋花·槛菊愁烟兰泣露",
    "who": "晏殊"
  },
  {
    "text": "矮纸斜行闲作草，晴窗细乳戏分茶。",
    "from": "临安春雨初霁",
    "who": "陆游"
  },
  {
    "text": "千金纵买相如赋，脉脉此情谁诉。",
    "from": "摸鱼儿·更能消几番风雨",
    "who": "辛弃疾"
  },
  {
    "text": "思慕，思慕，山外泪痕相顾。",
    "from": "如梦令·思故",
    "who": "碧水凌涛"
  },
  {
    "text": "连雨不知春去，一晴方觉夏深。",
    "from": "喜晴",
    "who": "范成大"
  },
  {
    "text": "直道相思了无益，未妨惆怅是清狂。",
    "from": "无题",
    "who": "李商隐"
  },
  {
    "text": "他年我若为青帝，报与桃花一处开。",
    "from": "题菊花",
    "who": "黄巢"
  },
  {
    "text": "独乐乐不如众乐乐。",
    "from": "孟子·梁惠王下",
    "who": "孟子"
  },
  {
    "text": "去年花里逢君别，今日花开已一年。",
    "from": "寄李儋元锡",
    "who": "韦应物"
  },
  {
    "text": "有情芍药含春泪，无力蔷薇卧晓枝。",
    "from": "春日",
    "who": "秦观"
  },
  {
    "text": "倚南窗以寄傲，审容膝之易安。园日涉以成趣，门虽设而常关。",
    "from": "归去来兮辞",
    "who": "陶渊明"
  },
  {
    "text": "南朝四百八十寺，多少楼台烟雨中。",
    "from": "江南春",
    "who": "杜牧"
  },
  {
    "text": "但使龙城飞将在，不教胡马度阴山。",
    "from": "出塞二首",
    "who": "王昌龄"
  }
]
