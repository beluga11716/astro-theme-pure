{
  "extends": "astro/tsconfigs/strict",
  "include": ["./.astro/types.d.ts", "./**/*"],
  "compilerOptions": {
    // Basic
    "allowJs": true,
    // Building for a library
    "declaration": true,
    // Code runs in the DOM
    "lib": ["es2022", "dom", "dom.iterable"],
    // Type Imports
    "verbatimModuleSyntax": true,
    // Others
    "strictNullChecks": true,
    // Paths
    "paths": {
      "@/assets/*": ["./src/assets/*"],
      "@/public/*": ["./public/*"],
      "@/components/*": ["./src/components/*"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/utils": ["./src/utils/index.ts"],
      "@/utils/*": ["./src/utils/*"],
      "@/plugins/*": ["./src/plugins/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/types": ["./src/types/index.ts"],
      "@/site-config": ["./src/site.config.ts"]
    }
    // https://docs.astro.build/en/guides/typescript/#typescript-editor-plugin
  },
  // `public/scripts/*` 与 `public/vendor/*` 是原样搬运的第三方脚本，
  // allowJs 会把它们一起类型检查并报出上游自己的过时 API 警告，故排除。
  "exclude": [
    "./node_modules",
    "./**/node_modules/*",
    "./.vscode",
    "./dist",
    "./public/scripts/*",
    "./public/vendor/*",
    "./test/*"
  ]
}
