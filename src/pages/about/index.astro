---
import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'about-me', text: '關於我' },
  { depth: 2, slug: 'social-networks', text: '社群' },
  { depth: 2, slug: 'about-blog', text: '關於本站' }
]

const links = [
  { icon: 'github', label: 'GitHub', href: 'https://github.com/beluga11716' },
  { icon: 'x', label: 'X', href: 'https://x.com/raynard11716' },
  { icon: 'telegram', label: 'Telegram', href: 'https://t.me/+jjPi8QtiO2ZhMzE9' },
  { icon: 'email', label: 'Email', href: 'https://mail.raynard.lol/' }
] as const
---

<PageLayout title='關於' {headings}>
  <h2 id='about-me'>關於我</h2>
  <p>RAYNARD</p>
  <p>its not hard. its just new.</p>
  <p>感謝你的來訪.希望在這裡能找到對你有用的內容.</p>

  <h2 id='social-networks'>社群</h2>
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href} target='_blank' rel='noopener noreferrer'>
            <Icon name={link.icon} class='me-1 align-text-bottom' />
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>

  <h2 id='about-blog'>關於本站</h2>
  <p>
    這裡是一個靜態 blog，主要記錄一些折騰過的軟體、工具和使用心得，偶爾也會寫點別的東西。
  </p>
  <p>
    blog 最初基於 <a href='https://github.com/CuteLeaf/Firefly' target='_blank'>Firefly</a> 主題，
    後來改用 <a href='https://github.com/cworld1/astro-theme-pure' target='_blank'
      >Astro Theme Pure</a
    >，文章內容一併遷移了過來。
  </p>
  <p>本站由以下專案與服務支撐：</p>
  <ul>
    <li>
      框架：<a href='https://astro.build/' target='_blank'>Astro</a>
    </li>
    <li>
      主題：<a href='https://github.com/cworld1/astro-theme-pure' target='_blank'
        >Astro Theme Pure</a
      >
    </li>
    <li>
      部署：<a href='https://vercel.com/' target='_blank'>Vercel</a>
    </li>
    <li>
      搜尋：<a href='https://pagefind.app/' target='_blank'>Pagefind</a>
    </li>
  </ul>
</PageLayout>
